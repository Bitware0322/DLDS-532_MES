<UserControl x:Class="DLDS532.App.Views.FieldsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DLDS532.App.Controls"
             xmlns:vm="clr-namespace:DLDS532.App.ViewModels"
             FontFamily="{StaticResource F.Sans}">

    <UserControl.Resources>
        <DataTemplate x:Key="FieldRowTemplate" DataType="{x:Type vm:FieldRowVm}">
            <Grid x:Name="Row" Height="25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="178" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="4" Height="1" VerticalAlignment="Bottom" Background="#0F1B5478" />
                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource B.Label}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding TypeLabel}" FontFamily="{StaticResource F.Num}"
                           FontSize="11.5" VerticalAlignment="Center" Foreground="{StaticResource B.Muted}" />
                <TextBlock Grid.Column="2" Text="{Binding Address}" FontFamily="{StaticResource F.Num}"
                           FontSize="11.5" VerticalAlignment="Center" Foreground="{StaticResource B.AccentDim}" />
                <TextBlock Grid.Column="3" Text="{Binding Value}" FontFamily="{StaticResource F.Num}"
                           FontSize="12.5" VerticalAlignment="Center" Foreground="{StaticResource B.Value}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Show}" Value="False">
                    <Setter TargetName="Row" Property="Opacity" Value="0.55" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="16" />
            <RowDefinition Height="936" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="DB120 全部字段实时值" FontSize="15" FontWeight="SemiBold"
                           Foreground="#FFD8EEFF" />
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource T.LabelSm}" Margin="14,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <controls:Lamp Color="{StaticResource B.Accent}" Diameter="7" VerticalAlignment="Center" />
                <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource T.LabelSm}" Margin="7,0,16,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="灰色行 = 保留字段 / 不上屏字段" Style="{StaticResource T.LabelSm}"
                           Foreground="{StaticResource B.Gray}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="452" />
                <RowDefinition Height="16" />
                <RowDefinition Height="452" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="892" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="908" />
            </Grid.ColumnDefinitions>

            <controls:PanelCard Grid.Row="0" Grid.Column="0" IsHighlighted="{Binding IsHighlighted}" Title="一站数据 · 自动供料"
                                DataContext="{Binding Groups[0]}">
                <controls:PanelCard.HeaderRight>
                    <TextBlock Text="{Binding Caption}" Style="{StaticResource T.LabelSm}" />
                </controls:PanelCard.HeaderRight>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="178" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="变量名" Style="{StaticResource T.TableHead}" />
                        <TextBlock Grid.Column="1" Text="类型" Style="{StaticResource T.TableHead}" />
                        <TextBlock Grid.Column="2" Text="偏移" Style="{StaticResource T.TableHead}" />
                        <TextBlock Grid.Column="3" Text="当前值" Style="{StaticResource T.TableHead}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource FieldRowTemplate}" />
                    </ScrollViewer>
                </Grid>
            </controls:PanelCard>

            <controls:PanelCard Grid.Row="0" Grid.Column="2" IsHighlighted="{Binding IsHighlighted}" Title="二站数据 · 智能分拣"
                                DataContext="{Binding Groups[1]}">
                <controls:PanelCard.HeaderRight>
                    <TextBlock Text="{Binding Caption}" Style="{StaticResource T.LabelSm}" />
                </controls:PanelCard.HeaderRight>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="178" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="变量名" Style="{StaticResource T.TableHead}" />
                        <TextBlock Grid.Column="1" Text="类型" Style="{StaticResource T.TableHead}" />
                        <TextBlock Grid.Column="2" Text="偏移" Style="{StaticResource T.TableHead}" />
                        <TextBlock Grid.Column="3" Text="当前值" Style="{StaticResource T.TableHead}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource FieldRowTemplate}" />
                    </ScrollViewer>
                </Grid>
            </controls:PanelCard>

            <controls:PanelCard Grid.Row="2" Grid.Column="0" IsHighlighted="{Binding IsHighlighted}" Title="三站数据 · 智能仓储"
                                DataContext="{Binding Groups[2]}">
                <controls:PanelCard.HeaderRight>
                    <TextBlock Text="{Binding Caption}" Style="{StaticResource T.LabelSm}" />
                </controls:PanelCard.HeaderRight>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="178" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="变量名" Style="{StaticResource T.TableHead}" />
                        <TextBlock Grid.Column="1" Text="类型" Style="{StaticResource T.TableHead}" />
                        <TextBlock Grid.Column="2" Text="偏移" Style="{StaticResource T.TableHead}" />
                        <TextBlock Grid.Column="3" Text="当前值" Style="{StaticResource T.TableHead}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource FieldRowTemplate}" />
                    </ScrollViewer>
                </Grid>
            </controls:PanelCard>

            <controls:PanelCard Grid.Row="2" Grid.Column="2" IsHighlighted="{Binding IsHighlighted}" Title="订单数据 · DB120 镜像"
                                DataContext="{Binding Groups[3]}">
                <controls:PanelCard.HeaderRight>
                    <TextBlock Text="{Binding Caption}" Style="{StaticResource T.LabelSm}" />
                </controls:PanelCard.HeaderRight>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="178" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="变量名" Style="{StaticResource T.TableHead}" />
                        <TextBlock Grid.Column="1" Text="类型" Style="{StaticResource T.TableHead}" />
                        <TextBlock Grid.Column="2" Text="偏移" Style="{StaticResource T.TableHead}" />
                        <TextBlock Grid.Column="3" Text="当前值" Style="{StaticResource T.TableHead}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource FieldRowTemplate}" />
                    </ScrollViewer>
                </Grid>
            </controls:PanelCard>
        </Grid>
    </Grid>
</UserControl>
