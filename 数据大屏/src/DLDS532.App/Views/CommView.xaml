<UserControl x:Class="DLDS532.App.Views.CommView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DLDS532.App.Controls"
             FontFamily="{StaticResource F.Sans}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="892" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="908" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="486" />
            <RowDefinition Height="16" />
            <RowDefinition Height="486" />
        </Grid.RowDefinitions>

        <!-- 连接信息 -->
        <controls:PanelCard Grid.Row="0" Grid.Column="0" Title="连接信息">
            <controls:PanelCard.HeaderRight>
                <StackPanel Orientation="Horizontal">
                    <controls:StatusChip Text="{Binding StateText}" Color="{Binding StateBrush}" Margin="0,0,6,0" />
                    <controls:StatusChip Text="{Binding CpuText}" Color="{Binding CpuBrush}" />
                </StackPanel>
            </controls:PanelCard.HeaderRight>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="PLC 目标地址" Style="{StaticResource T.Label}" />
                    <TextBlock Text="{Binding EndpointText}" FontFamily="{StaticResource F.Num}" FontSize="24"
                               Foreground="{StaticResource B.Accent}" Margin="0,5,0,0" />
                </StackPanel>

                <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,28,0,0">
                    <controls:Metric Label="读取数据块" Value="{Binding DbText}" ValueSize="18" />
                    <controls:Metric Label="数据帧长" Value="{Binding FrameText}" ValueSize="18" />
                    <controls:Metric Label="刷新周期" Value="{Binding PollText}" ValueSize="18" />
                    <controls:Metric Label="连接超时" Value="{Binding TimeoutText}" ValueSize="18" />
                </UniformGrid>

                <Border Grid.Row="2" Height="1" Background="#FF2A3E4C" Margin="0,28,0,24" />

                <UniformGrid Grid.Row="3" Rows="1" Columns="3">
                    <controls:Metric Label="连接状态" Value="{Binding StateText}"
                                     ValueBrush="{Binding StateBrush}" ValueSize="18" />
                    <controls:Metric Label="CPU 状态" Value="{Binding CpuText}"
                                     ValueBrush="{Binding CpuBrush}" ValueSize="18" />
                    <controls:Metric Label="本次连接时长" Value="{Binding ConnectedForText}" ValueSize="18" />
                </UniformGrid>

                <Border Grid.Row="4" Height="1" Background="#FF2A3E4C" Margin="0,26,0,22" />

                <UniformGrid Grid.Row="5" Rows="1" Columns="3" VerticalAlignment="Top">
                    <controls:Metric Label="已读帧数" Value="{Binding FramesText}" Unit="帧" ValueSize="18" />
                    <controls:Metric Label="累计读取" Value="{Binding BytesText}" ValueSize="18" />
                    <controls:Metric Label="数据源" Value="{Binding SourceName}" ValueSize="18"
                                     ValueBrush="{StaticResource B.Amber}" />
                </UniformGrid>
            </Grid>
        </controls:PanelCard>

        <!-- 通信统计 -->
        <controls:PanelCard Grid.Row="0" Grid.Column="2" Title="通信统计">
            <controls:PanelCard.HeaderRight>
                <TextBlock Text="每次读取的实时累计，切换页面不清零" Style="{StaticResource T.LabelSm}" />
            </controls:PanelCard.HeaderRight>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <UniformGrid Rows="1" Columns="2">
                    <controls:Metric Label="通信成功次数" Value="{Binding SuccessText}" Unit="次" ValueSize="22"
                                     ValueBrush="{StaticResource B.Green}" />
                    <controls:Metric Label="通信失败次数" Value="{Binding FailText}" Unit="次" ValueSize="22"
                                     ValueBrush="{StaticResource B.Red}" />
                </UniformGrid>

                <Border Grid.Row="1" Height="1" Background="#FF2A3E4C" Margin="0,28,0,24" />

                <UniformGrid Grid.Row="2" Rows="1" Columns="2">
                    <controls:Metric Label="成功率" Value="{Binding SuccessRateText}" ValueSize="22" />
                    <controls:Metric Label="当前延迟" Value="{Binding LatencyText}" ValueSize="22" />
                </UniformGrid>

                <Border Grid.Row="3" Height="1" Background="#FF2A3E4C" Margin="0,28,0,24" />

                <UniformGrid Grid.Row="4" Rows="1" Columns="2">
                    <controls:Metric Label="最近一次成功通信" Value="{Binding LastSuccessText}" ValueSize="18" />
                    <controls:Metric Label="最近一次读取尝试" Value="{Binding LastAttemptText}" ValueSize="18" />
                </UniformGrid>

                <Border Grid.Row="5" Height="1" Background="#FF2A3E4C" Margin="0,26,0,22" />

                <StackPanel Grid.Row="6">
                    <TextBlock Text="最近错误" Style="{StaticResource T.LabelSm}" />
                    <TextBlock Text="{Binding ErrorText}" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap"
                               Foreground="{Binding ErrorBrush}" />
                </StackPanel>
            </Grid>
        </controls:PanelCard>

        <!-- 通信控制 -->
        <controls:PanelCard Grid.Row="2" Grid.Column="0" Title="通信控制">
            <controls:PanelCard.HeaderRight>
                <TextBlock Text="手动干预入口" Style="{StaticResource T.LabelSm}" />
            </controls:PanelCard.HeaderRight>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Btn.ChipPrimary}" Content="手动连接"
                            Command="{Binding ConnectCommand}" Padding="26,11" FontSize="14" Margin="0,0,12,0" />
                    <Button Style="{StaticResource Btn.Chip}" Content="断开连接"
                            Command="{Binding DisconnectCommand}" Padding="26,11" FontSize="14" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
                    <CheckBox Style="{StaticResource Check.Dark}" Content="断线自动重连" IsChecked="{Binding AutoReconnect}" />
                    <TextBlock Text="{Binding AutoReconnectText}" Style="{StaticResource T.LabelSm}"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Row="2" Height="1" Background="#221B5478" Margin="0,26,0,20" />

                <StackPanel Grid.Row="3">
                    <TextBlock Text="链路测试" Style="{StaticResource T.Label}" />
                    <Button Style="{StaticResource Btn.Chip}" Content="模拟断线（验证自动重连）"
                            Command="{Binding ToggleOfflineCommand}" Padding="16,8" Margin="0,10,0,0"
                            HorizontalAlignment="Left" IsEnabled="{Binding CanSimulateOffline}" />
                    <TextBlock Text="{Binding SimulatedOfflineText}" FontSize="12.5" Margin="0,10,0,0"
                               Foreground="{Binding SimulatedOfflineBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,14,0,0">
                    <TextBlock Text="现场连通检查清单" Style="{StaticResource T.Label}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource T.LabelSm}" Text="1. DB120 属性中「优化的块访问」未勾选（必须为非优化）" />
                    <TextBlock Style="{StaticResource T.LabelSm}" Margin="0,3,0,0" Text="2. CPU 属性 → 防护与安全 → 勾选「允许来自远程伙伴的 PUT/GET 通信访问」" />
                    <TextBlock Style="{StaticResource T.LabelSm}" Margin="0,3,0,0" Text="3. DB 号 = 120、可读长度 190 字节；Rack 0 / Slot 1（1214C 默认）" />
                    <TextBlock Style="{StaticResource T.LabelSm}" Margin="0,3,0,0" Text="4. 本机与 PLC 同网段且 102 端口可达（ping / Test-NetConnection）" />
                </StackPanel>

                <TextBlock Grid.Row="5" VerticalAlignment="Bottom" TextWrapping="Wrap"
                           Style="{StaticResource T.LabelSm}" Foreground="{StaticResource B.Gray}"
                           Text="断线后读取立即失败，大屏数值转为灰色并标记「数据已过期」；自动重连按设定间隔重试，恢复后回到实时状态，全程无需重启软件。" />
            </Grid>
        </controls:PanelCard>

        <!-- 心跳监测 -->
        <controls:PanelCard Grid.Row="2" Grid.Column="2" Title="心跳监测">
            <controls:PanelCard.HeaderRight>
                <TextBlock Text="DB120 14.0 / 72.0 / 118.0" Style="{StaticResource T.LabelSm}" />
            </controls:PanelCard.HeaderRight>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <UniformGrid Rows="1" Columns="3">
                    <controls:Metric Label="一站心跳" Value="{Binding HeartbeatS1Text}" ValueSize="22" />
                    <controls:Metric Label="二站心跳" Value="{Binding HeartbeatS2Text}" ValueSize="22" />
                    <controls:Metric Label="三站心跳" Value="{Binding HeartbeatS3Text}" ValueSize="22" />
                </UniformGrid>

                <Border Grid.Row="1" Height="1" Background="#FF2A3E4C" Margin="0,28,0,24" />

                <StackPanel Grid.Row="2">
                    <TextBlock Text="判读方式" Style="{StaticResource T.Label}" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource T.LabelSm}"
                               Text="DB120 每站的「心跳值」是 PLC 侧写入的 16 位自增计数器：数值变化 = 本站工艺程序在刷新；数值停滞 = CPU STOP 或程序未运行。它不是 S7 通信心跳，通信是否正常以读取成功与延迟为准。" />
                    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Style="{StaticResource T.LabelSm}"
                               Foreground="{StaticResource B.Gray}"
                               Text="数值超过 32767 会回绕为负数，界面统一按无符号 16 位显示，避免出现负心跳误导判断。" />
                </StackPanel>

                <TextBlock Grid.Row="3" VerticalAlignment="Bottom" Style="{StaticResource T.LabelSm}"
                           Foreground="{StaticResource B.Gray}"
                           Text="阶段五会把心跳停滞做成报警条目（连续 N 个周期无变化即触发），当前阶段仅在通信页观察。" />
            </Grid>
        </controls:PanelCard>
    </Grid>
</UserControl>
