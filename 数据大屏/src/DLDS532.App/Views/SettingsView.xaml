<UserControl x:Class="DLDS532.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DLDS532.App.Controls"
             FontFamily="{StaticResource F.Sans}">

    <UserControl.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FormBox" TargetType="TextBox" BasedOn="{StaticResource Input.Dark}">
            <Setter Property="Width" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="892" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="908" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="486" />
            <RowDefinition Height="16" />
            <RowDefinition Height="486" />
        </Grid.RowDefinitions>

        <!-- 连接参数 -->
        <controls:PanelCard Grid.Row="0" Grid.Column="0" Title="PLC 连接参数">
            <controls:PanelCard.HeaderRight>
                <TextBlock Text="S7 协议 · TCP 102 · DB120 只读" Style="{StaticResource T.LabelSm}" />
            </controls:PanelCard.HeaderRight>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PLC IP 地址" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Column="1" Style="{StaticResource FormBox}"
                             Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="端口" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Column="1" Style="{StaticResource FormBox}"
                             Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Rack（机架）" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Column="1" Style="{StaticResource FormBox}"
                             Text="{Binding Rack, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Slot（槽位）" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Column="1" Style="{StaticResource FormBox}"
                             Text="{Binding Slot, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="DB 块编号" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Column="1" Style="{StaticResource FormBox}"
                             Text="{Binding DbNumberText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBlock Grid.Row="5" VerticalAlignment="Bottom" TextWrapping="Wrap"
                           Style="{StaticResource T.LabelSm}" Foreground="{StaticResource B.Gray}"
                           Text="S7-1200 需在 TIA 中勾选「允许来自远程伙伴的 PUT/GET 通信访问」，否则连接成功但读 DB 会报错。Rack 0 / Slot 1 为 1214C 默认值。" />
            </Grid>
        </controls:PanelCard>

        <!-- DB 映射 -->
        <controls:PanelCard Grid.Row="0" Grid.Column="2" Title="DB 数据映射">
            <controls:PanelCard.HeaderRight>
                <TextBlock Text="偏移只来自配置文件" Style="{StaticResource T.LabelSm}" />
            </controls:PanelCard.HeaderRight>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding MappingSummary}" FontSize="16" Foreground="{StaticResource B.Value}" />
                    <TextBlock Text="{Binding MappingPath}" Style="{StaticResource T.LabelSm}" Margin="0,10,0,0"
                               TextWrapping="Wrap" FontFamily="{StaticResource F.Num}" />
                </StackPanel>

                <Button Grid.Row="1" Style="{StaticResource Btn.Chip}" Content="打开映射文件所在目录"
                        Command="{Binding OpenFolderCommand}" Padding="16,8" HorizontalAlignment="Left"
                        Margin="0,20,0,0" />

                <Border Grid.Row="2" Height="1" Background="#221B5478" Margin="0,22,0,20" />

                <StackPanel Grid.Row="3">
                    <TextBlock Text="映射表由 TIA 导出文件 + 现场 190 字节实测校准生成，78 个字段的偏移全部写在 JSON 内，代码中没有任何硬编码地址。" TextWrapping="Wrap"
                               Style="{StaticResource T.Label}" />
                    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Style="{StaticResource T.LabelSm}"
                               Foreground="{StaticResource B.Amber}"
                               Text="若现场 TIA 显示的偏移与本表不一致：只改 JSON，不改代码，改完重启软件。重点核对 10.0（一站步骤）、58.0 / 104.0（二站/三站起点）、121.0（仓位数组）、164.0（订单区）。" />
                </StackPanel>
            </Grid>
        </controls:PanelCard>

        <!-- 采集与重连 -->
        <controls:PanelCard Grid.Row="2" Grid.Column="0" Title="采集与重连策略">
            <controls:PanelCard.HeaderRight>
                <TextBlock Text="修改后点「应用设置」生效" Style="{StaticResource T.LabelSm}" />
            </controls:PanelCard.HeaderRight>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="数据源" Style="{StaticResource T.Label}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Style="{StaticResource Btn.SeriesChip}" Content="真实 PLC"
                                      IsChecked="{Binding IsRealMode, Mode=OneWay}"
                                      Command="{Binding SetRealModeCommand}" Padding="14,6" Margin="0,0,8,0" />
                        <ToggleButton Style="{StaticResource Btn.SeriesChip}" Content="模拟数据"
                                      IsChecked="{Binding IsSimulationMode, Mode=OneWay}"
                                      Command="{Binding SetSimulationModeCommand}" Padding="14,6" />
                    </StackPanel>
                    <TextBlock Text="{Binding DataSourceText}" Style="{StaticResource T.LabelSm}"
                               Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="刷新周期 (ms)" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Column="1" Style="{StaticResource FormBox}"
                             Text="{Binding PollInterval, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="连接超时 (ms)" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Column="1" Style="{StaticResource FormBox}"
                             Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="重连间隔 (ms)" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Column="1" Style="{StaticResource FormBox}"
                             Text="{Binding ReconnectInterval, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <CheckBox Grid.Row="4" Style="{StaticResource Check.Dark}" Content="断线自动重连"
                          IsChecked="{Binding AutoReconnect}" />

                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,26,0,0">
                    <Button Style="{StaticResource Btn.ChipPrimary}" Content="应用设置"
                            Command="{Binding ApplyCommand}" Padding="26,10" FontSize="14" Margin="0,0,12,0" />
                    <Button Style="{StaticResource Btn.Chip}" Content="恢复当前值"
                            Command="{Binding ResetCommand}" Padding="26,10" FontSize="14" />
                </StackPanel>

                <TextBlock Grid.Row="6" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5"
                           Margin="0,18,0,0" Foreground="{Binding MessageBrush}" />
            </Grid>
        </controls:PanelCard>

        <!-- 安全与阶段 -->
        <controls:PanelCard Grid.Row="2" Grid.Column="2" Title="安全边界与阶段说明">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="只读监控" FontSize="14" Foreground="{StaticResource B.Green}" />
                <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource T.Label}"
                           Text="软件不含任何写 PLC 的代码路径：不写 DB120、不写运行模式、不触发开始/复位信号、不操作伺服与气缸。通信层仅暴露读取接口，映射表中每个字段权限均为只读。" />

                <Border Grid.Row="2" Height="1" Background="#221B5478" Margin="0,18,0,18" />

                <StackPanel Grid.Row="3">
                    <TextBlock Text="当前阶段（二）已完成" FontSize="14" Foreground="{StaticResource B.Value}" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource T.Label}"
                               Text="DB120 解码 · 三栏大屏 · 实时趋势 · 仓位状态 · 订单信息 · 通信统计 · 全部字段查看 · 参数设置。数据源为模拟帧源（按真实偏移写入 190 字节）。" />
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,16,0,0">
                    <TextBlock Text="尚未提供的数据（不虚构）" FontSize="14" Foreground="{StaticResource B.Amber}" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource T.Label}"
                               Text="故障码含义、产品合格状态取值、在线状态语义、轴速度、传输带状态、历史订单队列 —— DB120 中不存在或含义未确认，界面按「原始值 + 明确标注」处理。" />
                </StackPanel>

                <TextBlock Grid.Row="5" VerticalAlignment="Bottom" TextWrapping="Wrap"
                           Style="{StaticResource T.LabelSm}" Foreground="{StaticResource B.Gray}"
                           Text="下一阶段：接入 S7 真实读取（S7netplus），逐字段与 TIA 监视表比对；随后补 SQLite 历史与报警、打包为免安装 exe。" />
            </Grid>
        </controls:PanelCard>
    </Grid>
</UserControl>
