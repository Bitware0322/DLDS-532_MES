<UserControl x:Class="DLDS532.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DLDS532.App.Controls"
             FontFamily="{StaticResource F.Sans}">

    <UserControl.Resources>
        <Style x:Key="FlowCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource B.Inset}" />
            <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource B.Accent}" />
                    <Setter Property="Background" Value="#FF23394A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFault}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource B.Red}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="484" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="802" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="498" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ 左栏 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="192" />
                <RowDefinition Height="16" />
                <RowDefinition Height="382" />
                <RowDefinition Height="16" />
                <RowDefinition Height="382" />
            </Grid.RowDefinitions>

            <!-- 数据管理 -->
            <controls:PanelCard Grid.Row="0" Title="数据管理">
                <controls:PanelCard.HeaderRight>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="更新" Style="{StaticResource T.Aux}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding UpdateText}" FontSize="11.5" Margin="6,0,0,0"
                                   Foreground="{StaticResource B.Label}" VerticalAlignment="Center"
                                   ToolTip="本帧数据的读取时间（DB120 整块 190 字节）" />
                    </StackPanel>
                </controls:PanelCard.HeaderRight>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:Lamp Color="{Binding ConnBrush}" Diameter="9" VerticalAlignment="Center" />
                            <TextBlock Text="数据管理 PLC" Style="{StaticResource T.Aux}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnText}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{Binding ConnBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="DB120" Style="{StaticResource T.Aux}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DbStateText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{Binding DbStateBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,14,0,0">
                        <controls:Metric Label="通信延迟" Value="{Binding LatencyText}" Unit="ms" ValueSize="15" />
                        <controls:Metric Label="刷新周期" Value="{Binding PollText}" Unit="ms" ValueSize="15" />
                        <controls:Metric Label="数据帧长" Value="{Binding FrameText}" Unit="B" ValueSize="15" />
                    </UniformGrid>

                    <UniformGrid Grid.Row="2" Columns="3" VerticalAlignment="Bottom">
                        <Border Background="#14FFFFFF" CornerRadius="6" Padding="9,5" Margin="0,0,6,0"
                                ToolTip="DB120 一站数据.在线状态 · 偏移 0.0 · 1=在线 0=离线">
                            <StackPanel Orientation="Horizontal">
                                <controls:Lamp Color="{Binding S1OnlineBrush}" Diameter="7" VerticalAlignment="Center" />
                                <TextBlock Text="一站" Style="{StaticResource T.Aux}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding S1OnlineText}" FontSize="11.5" Margin="5,0,0,0"
                                           Foreground="{Binding S1OnlineBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="#14FFFFFF" CornerRadius="6" Padding="9,5" Margin="3,0,3,0"
                                ToolTip="DB120 二站数据.在线状态 · 偏移 58.0 · 1=在线 0=离线">
                            <StackPanel Orientation="Horizontal">
                                <controls:Lamp Color="{Binding S2OnlineBrush}" Diameter="7" VerticalAlignment="Center" />
                                <TextBlock Text="二站" Style="{StaticResource T.Aux}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding S2OnlineText}" FontSize="11.5" Margin="5,0,0,0"
                                           Foreground="{Binding S2OnlineBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="#14FFFFFF" CornerRadius="6" Padding="9,5" Margin="6,0,0,0"
                                ToolTip="DB120 三站数据.在线状态 · 偏移 104.0 · 1=在线 0=离线">
                            <StackPanel Orientation="Horizontal">
                                <controls:Lamp Color="{Binding S3OnlineBrush}" Diameter="7" VerticalAlignment="Center" />
                                <TextBlock Text="三站" Style="{StaticResource T.Aux}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding S3OnlineText}" FontSize="11.5" Margin="5,0,0,0"
                                           Foreground="{Binding S3OnlineBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </controls:PanelCard>

            <!-- 自动供料单元 -->
            <controls:PanelCard Grid.Row="2" Title="自动供料单元" Cursor="Hand"
                                ToolTip="点击查看本单元全部 DB120 字段">
                <controls:PanelCard.InputBindings>
                    <MouseBinding MouseAction="LeftClick" CommandParameter="0"
                                  Command="{Binding DataContext.OpenUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </controls:PanelCard.InputBindings>
                <controls:PanelCard.HeaderRight>
                    <StackPanel Orientation="Horizontal">
                        <controls:StatusChip Text="{Binding S1ModeText}" Color="{Binding S1ModeBrush}" Margin="0,0,6,0" />
                        <controls:StatusChip Text="{Binding S1BusyText}" Color="{Binding S1BusyBrush}" Margin="0,0,6,0" />
                        <controls:StatusChip Text="{Binding S1FaultText}" Color="{Binding S1FaultBrush}"
                                             Pulse="{Binding S1IsFault}" />
                    </StackPanel>
                </controls:PanelCard.HeaderRight>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,10">
                        <Border Style="{StaticResource MiniCard}" Margin="0,0,5,0"
                                ToolTip="一站数据.当前订单ID · DB120 偏移 8.0 · INT">
                            <controls:Metric Label="当前订单 ID" Value="{Binding S1OrderText}" Emphasis="True"
                                             ValueBrush="{StaticResource B.Cyan}" VerticalAlignment="Center" />
                        </Border>
                        <Border Style="{StaticResource MiniCard}" Margin="5,0,0,0"
                                ToolTip="一站数据.当前步骤 · DB120 偏移 10.0 · REAL">
                            <controls:Metric Label="当前工艺步骤" Value="{Binding S1StepText}" ValueSize="20"
                                             VerticalAlignment="Center" />
                        </Border>
                    </UniformGrid>

                    <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,10">
                        <Border Style="{StaticResource MiniCard}" Margin="0,0,5,0"
                                ToolTip="一站数据.转盘当前角度 · DB120 偏移 20.0 · REAL">
                            <controls:Metric Label="转盘当前角度" Value="{Binding S1AngleText}" Unit="°" ValueSize="20"
                                             ValueBrush="{StaticResource B.Accent}" VerticalAlignment="Center" />
                        </Border>
                        <Border Style="{StaticResource MiniCard}" Margin="5,0,0,0"
                                ToolTip="一站数据.机械手当前位置 · DB120 偏移 24.0 · REAL">
                            <controls:Metric Label="机械手当前位置" Value="{Binding S1RobotText}" Unit="mm" ValueSize="20"
                                             VerticalAlignment="Center" />
                        </Border>
                    </UniformGrid>

                    <UniformGrid Grid.Row="2" Columns="2">
                        <Border Style="{StaticResource MiniCard}" Margin="0,0,5,0"
                                ToolTip="一站数据.深度检测值 · DB120 偏移 28.0 · REAL">
                            <controls:Metric Label="深度检测值" Value="{Binding S1DepthText}" Unit="mm" Emphasis="True"
                                             ValueBrush="{StaticResource B.Cyan}" VerticalAlignment="Center" />
                        </Border>
                        <Border Style="{StaticResource MiniCard}" Margin="5,0,0,0"
                                ToolTip="一站数据.A料使用数 34.0 / B料使用数 36.0 · INT">
                            <controls:Metric Label="A / B 料使用数" Value="{Binding S1MaterialText}" ValueSize="20"
                                             VerticalAlignment="Center" />
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="3" BorderBrush="#FF2A3E4C" BorderThickness="0,1,0,0" Margin="0,12,0,0"
                            Padding="0,10,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="扫码" Style="{StaticResource T.Aux}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding S1ScanText}" FontSize="13" Foreground="{StaticResource B.Label}"
                                           Margin="6,0,16,0" VerticalAlignment="Center" />
                                <controls:Lamp Color="{Binding S1DoneBrush}" Diameter="6" VerticalAlignment="Center" />
                                <TextBlock Text="完成" Style="{StaticResource T.Aux}" Margin="5,0,14,0" VerticalAlignment="Center" />
                                <controls:Lamp Color="{Binding S1RecvBrush}" Diameter="6" VerticalAlignment="Center" />
                                <TextBlock Text="已接收" Style="{StaticResource T.Aux}" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="工作时间" Style="{StaticResource T.Aux}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding S1WorkTimeText}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource B.Label}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </controls:PanelCard>

            <!-- 智能分拣单元 -->
            <controls:PanelCard Grid.Row="4" Title="智能分拣单元" Cursor="Hand"
                                ToolTip="点击查看本单元全部 DB120 字段">
                <controls:PanelCard.InputBindings>
                    <MouseBinding MouseAction="LeftClick" CommandParameter="1"
                                  Command="{Binding DataContext.OpenUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </controls:PanelCard.InputBindings>
                <controls:PanelCard.HeaderRight>
                    <StackPanel Orientation="Horizontal">
                        <controls:StatusChip Text="{Binding S2ModeText}" Color="{Binding S2ModeBrush}" Margin="0,0,6,0" />
                        <controls:StatusChip Text="{Binding S2BusyText}" Color="{Binding S2BusyBrush}" Margin="0,0,6,0" />
                        <controls:StatusChip Text="{Binding S2FaultText}" Color="{Binding S2FaultBrush}"
                                             Pulse="{Binding S2IsFault}" />
                    </StackPanel>
                </controls:PanelCard.HeaderRight>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,10">
                        <Border Style="{StaticResource MiniCard}" Margin="0,0,5,0"
                                ToolTip="二站数据.当前订单ID · DB120 偏移 66.0 · INT">
                            <controls:Metric Label="当前订单 ID" Value="{Binding S2OrderText}" Emphasis="True"
                                             ValueBrush="{StaticResource B.Cyan}" VerticalAlignment="Center" />
                        </Border>
                        <Border Style="{StaticResource MiniCard}" Margin="5,0,0,0"
                                ToolTip="二站数据.当前步骤 · DB120 偏移 68.0 · REAL">
                            <controls:Metric Label="当前工艺步骤" Value="{Binding S2StepText}" ValueSize="20"
                                             VerticalAlignment="Center" />
                        </Border>
                    </UniformGrid>

                    <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,10">
                        <Border Style="{StaticResource MiniCard}" Margin="0,0,5,0"
                                ToolTip="二站数据.8mm已灌注数量 · DB120 偏移 78.0 · INT">
                            <controls:Metric Label="8mm 灌注数量" Value="{Binding S2Inject8Text}" Unit="颗" ValueSize="20"
                                             ValueBrush="{StaticResource B.Purple}" VerticalAlignment="Center" />
                        </Border>
                        <Border Style="{StaticResource MiniCard}" Margin="5,0,0,0"
                                ToolTip="二站数据.10mm已灌注数量 · DB120 偏移 80.0 · INT">
                            <controls:Metric Label="10mm 灌注数量" Value="{Binding S2Inject10Text}" Unit="颗" ValueSize="20"
                                             ValueBrush="{StaticResource B.Amber}" VerticalAlignment="Center" />
                        </Border>
                    </UniformGrid>

                    <UniformGrid Grid.Row="2" Columns="2">
                        <Border Style="{StaticResource MiniCard}" Margin="0,0,5,0"
                                ToolTip="二站数据.8mml料仓钢珠有无 · DB120 偏移 82.0 · BOOL">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="8mm 料仓" Style="{StaticResource T.Label}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <controls:Lamp Color="{Binding S2Hopper8Brush}" Diameter="9" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding S2Hopper8Text}" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{Binding S2Hopper8Brush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MiniCard}" Margin="5,0,0,0"
                                ToolTip="二站数据.10mm料仓钢珠有无 · DB120 偏移 82.1 · BOOL">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="10mm 料仓" Style="{StaticResource T.Label}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <controls:Lamp Color="{Binding S2Hopper10Brush}" Diameter="9" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding S2Hopper10Text}" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{Binding S2Hopper10Brush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="3" BorderBrush="#FF2A3E4C" BorderThickness="0,1,0,0" Margin="0,12,0,0"
                            Padding="0,10,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="扫码" Style="{StaticResource T.Aux}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding S2ScanText}" FontSize="13" Foreground="{StaticResource B.Label}"
                                           Margin="6,0,16,0" VerticalAlignment="Center" />
                                <controls:Lamp Color="{Binding S2DoneBrush}" Diameter="6" VerticalAlignment="Center" />
                                <TextBlock Text="完成" Style="{StaticResource T.Aux}" Margin="5,0,14,0" VerticalAlignment="Center" />
                                <controls:Lamp Color="{Binding S2RecvBrush}" Diameter="6" VerticalAlignment="Center" />
                                <TextBlock Text="已接收" Style="{StaticResource T.Aux}" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="工作时间" Style="{StaticResource T.Aux}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding S2WorkTimeText}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource B.Label}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </controls:PanelCard>
        </Grid>

        <!-- ============================================================ 中栏 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="316" />
                <RowDefinition Height="16" />
                <RowDefinition Height="656" />
            </Grid.RowDefinitions>

            <!-- 产线工艺流程总览 -->
            <controls:PanelCard Grid.Row="0" Title="产线工艺流程总览">
                <controls:PanelCard.HeaderRight>
                    <TextBlock Text="三单元按 DB120 实际状态独立显示" Style="{StaticResource T.Aux}" />
                </controls:PanelCard.HeaderRight>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="208" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="208" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="208" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource FlowCard}" Cursor="Hand"
                                DataContext="{Binding FlowUnits[0]}"
                                ToolTip="点击查看自动供料单元全部 DB120 字段">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" CommandParameter="0"
                                              Command="{Binding DataContext.OpenUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource B.Value}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <controls:Lamp Color="{Binding StateBrush}" Diameter="7" Pulse="{Binding IsFault}" />
                                        <TextBlock Text="{Binding StateText}" FontSize="11.5" Margin="6,0,0,0"
                                                   Foreground="{Binding StateBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                    <TextBlock Text="当前订单" Style="{StaticResource T.Aux}" />
                                    <TextBlock Text="{Binding OrderText}" FontSize="24" FontWeight="SemiBold"
                                               Foreground="{StaticResource B.Cyan}" Margin="0,1,0,0" />
                                </StackPanel>

                                <ItemsControl Grid.Row="2" ItemsSource="{Binding Rows}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="22">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource T.Aux}"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{Binding ValueBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Unit}" Style="{StaticResource T.Unit}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Grid.Row="4" BorderBrush="#FF2A3E4C" BorderThickness="0,1,0,0"
                                        Padding="0,8,0,0" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Lamp Color="{Binding DoneBrush}" Diameter="6" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DoneText}" Style="{StaticResource T.Aux}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" VerticalAlignment="Center" DataContext="{Binding FlowUnits[0]}">
                            <Path Data="M2,10 L38,10 M32,4 L38,10 L32,16" Width="42" Height="20"
                                  StrokeThickness="1.8" StrokeDashCap="Round" HorizontalAlignment="Center"
                                  ToolTip="工艺流向：自动供料 → 智能分拣">
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset"
                                                                 From="0" To="-18" Duration="0:0:1.6" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Stroke" Value="{StaticResource B.Border}" />
                                        <Setter Property="StrokeDashArray" Value="5 4" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Stroke" Value="{StaticResource B.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>

                        <Border Grid.Column="2" Style="{StaticResource FlowCard}" Cursor="Hand"
                                DataContext="{Binding FlowUnits[1]}"
                                ToolTip="点击查看智能分拣单元全部 DB120 字段">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" CommandParameter="1"
                                              Command="{Binding DataContext.OpenUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource B.Value}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <controls:Lamp Color="{Binding StateBrush}" Diameter="7" Pulse="{Binding IsFault}" />
                                        <TextBlock Text="{Binding StateText}" FontSize="11.5" Margin="6,0,0,0"
                                                   Foreground="{Binding StateBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                    <TextBlock Text="当前订单" Style="{StaticResource T.Aux}" />
                                    <TextBlock Text="{Binding OrderText}" FontSize="24" FontWeight="SemiBold"
                                               Foreground="{StaticResource B.Cyan}" Margin="0,1,0,0" />
                                </StackPanel>

                                <ItemsControl Grid.Row="2" ItemsSource="{Binding Rows}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="22">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource T.Aux}"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{Binding ValueBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Unit}" Style="{StaticResource T.Unit}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Grid.Row="4" BorderBrush="#FF2A3E4C" BorderThickness="0,1,0,0"
                                        Padding="0,8,0,0" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Lamp Color="{Binding DoneBrush}" Diameter="6" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DoneText}" Style="{StaticResource T.Aux}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="3" VerticalAlignment="Center" DataContext="{Binding FlowUnits[1]}">
                            <Path Data="M2,10 L38,10 M32,4 L38,10 L32,16" Width="42" Height="20"
                                  StrokeThickness="1.8" StrokeDashCap="Round" HorizontalAlignment="Center"
                                  ToolTip="工艺流向：智能分拣 → 智能仓储">
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset"
                                                                 From="0" To="-18" Duration="0:0:1.6" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Stroke" Value="{StaticResource B.Border}" />
                                        <Setter Property="StrokeDashArray" Value="5 4" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Stroke" Value="{StaticResource B.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>

                        <Border Grid.Column="4" Style="{StaticResource FlowCard}" Cursor="Hand"
                                DataContext="{Binding FlowUnits[2]}"
                                ToolTip="点击查看智能仓储单元全部 DB120 字段">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" CommandParameter="2"
                                              Command="{Binding DataContext.OpenUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource B.Value}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <controls:Lamp Color="{Binding StateBrush}" Diameter="7" Pulse="{Binding IsFault}" />
                                        <TextBlock Text="{Binding StateText}" FontSize="11.5" Margin="6,0,0,0"
                                                   Foreground="{Binding StateBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                    <TextBlock Text="当前订单" Style="{StaticResource T.Aux}" />
                                    <TextBlock Text="{Binding OrderText}" FontSize="24" FontWeight="SemiBold"
                                               Foreground="{StaticResource B.Cyan}" Margin="0,1,0,0" />
                                </StackPanel>

                                <ItemsControl Grid.Row="2" ItemsSource="{Binding Rows}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="22">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource T.Aux}"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{Binding ValueBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Unit}" Style="{StaticResource T.Unit}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Grid.Row="4" BorderBrush="#FF2A3E4C" BorderThickness="0,1,0,0"
                                        Padding="0,8,0,0" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Lamp Color="{Binding DoneBrush}" Diameter="6" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DoneText}" Style="{StaticResource T.Aux}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                    </Grid>

                    <!-- 产线状态汇总 -->
                    <Border Grid.Row="1" BorderBrush="#FF2A3E4C" BorderThickness="0,1,0,0"
                            Padding="0,10,0,0" Margin="0,10,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:Lamp Color="{Binding S1OnlineBrush}" Diameter="7" VerticalAlignment="Center" />
                                <TextBlock Text="一站" Style="{StaticResource T.Aux}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding S1OnlineText}" FontSize="11.5" Margin="5,0,18,0"
                                           Foreground="{Binding S1OnlineBrush}" VerticalAlignment="Center" />
                                <controls:Lamp Color="{Binding S2OnlineBrush}" Diameter="7" VerticalAlignment="Center" />
                                <TextBlock Text="二站" Style="{StaticResource T.Aux}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding S2OnlineText}" FontSize="11.5" Margin="5,0,18,0"
                                           Foreground="{Binding S2OnlineBrush}" VerticalAlignment="Center" />
                                <controls:Lamp Color="{Binding S3OnlineBrush}" Diameter="7" VerticalAlignment="Center" />
                                <TextBlock Text="三站" Style="{StaticResource T.Aux}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding S3OnlineText}" FontSize="11.5" Margin="5,0,0,0"
                                           Foreground="{Binding S3OnlineBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="运行单元" Style="{StaticResource T.Aux}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RunningStationsText}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource B.Accent}" Margin="6,0,16,0" VerticalAlignment="Center" />
                                <TextBlock Text="故障单元" Style="{StaticResource T.Aux}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FaultStationsText}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{Binding FaultStationsBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </controls:PanelCard>

            <!-- 实时趋势 -->
            <controls:PanelCard Grid.Row="2" Title="生产过程实时趋势">
                <controls:PanelCard.HeaderRight>
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Style="{StaticResource Btn.SeriesChip}" Content="5" Margin="0,0,4,0"
                                      IsChecked="{Binding IsWindow5, Mode=OneWay}"
                                      Command="{Binding SetWindowCommand}" CommandParameter="5" />
                        <ToggleButton Style="{StaticResource Btn.SeriesChip}" Content="15" Margin="0,0,4,0"
                                      IsChecked="{Binding IsWindow15, Mode=OneWay}"
                                      Command="{Binding SetWindowCommand}" CommandParameter="15" />
                        <ToggleButton Style="{StaticResource Btn.SeriesChip}" Content="30" Margin="0,0,4,0"
                                      IsChecked="{Binding IsWindow30, Mode=OneWay}"
                                      Command="{Binding SetWindowCommand}" CommandParameter="30" />
                        <ToggleButton Style="{StaticResource Btn.SeriesChip}" Content="60" Margin="0,0,12,0"
                                      IsChecked="{Binding IsWindow60, Mode=OneWay}"
                                      Command="{Binding SetWindowCommand}" CommandParameter="60" />
                        <Button Style="{StaticResource Btn.Chip}" Content="{Binding PauseText}"
                                Command="{Binding PauseCommand}" Margin="0,0,6,0" Padding="12,4" />
                        <Button Style="{StaticResource Btn.Chip}" Content="清空"
                                Command="{Binding ClearTrendCommand}" Padding="12,4" />
                    </StackPanel>
                </controls:PanelCard.HeaderRight>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <ItemsControl ItemsSource="{Binding TrendGroups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource Btn.SeriesChip}" Margin="0,0,6,0"
                                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                  CommandParameter="{Binding}"
                                                  Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                        <TextBlock Text="{Binding Caption}" FontSize="11.5" />
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding WindowText}" Style="{StaticResource T.Aux}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <controls:TrendChart Grid.Row="1" Buffer="{Binding TrendBuffer}" Series="{Binding ChartSeries}"
                                         WindowMinutes="{Binding WindowMinutes}" UnitLabel="{Binding ChartUnit}" />

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding GroupSeries}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource Btn.SeriesChip}" Margin="0,0,8,0" Padding="7,3"
                                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              CommandParameter="{Binding}"
                                              Command="{Binding DataContext.ToggleSeriesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="14" Height="3" RadiusX="1.5" RadiusY="1.5"
                                                   Fill="{Binding Stroke}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CurrentText}" Margin="7,0,0,0" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" Foreground="{Binding Stroke}" />
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock Text="{Binding SelectedSeriesText}" Style="{StaticResource T.Aux}" />
                        <TextBlock Text="暂停只停入图，PLC 采集与报警不中断" Style="{StaticResource T.Aux}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </controls:PanelCard>
        </Grid>

        <!-- ============================================================ 右栏 -->
        <Grid Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="260" />
                <RowDefinition Height="16" />
                <RowDefinition Height="256" />
                <RowDefinition Height="16" />
                <RowDefinition Height="440" />
            </Grid.RowDefinitions>

            <!-- 轴角度 / 轴位移 -->
            <controls:PanelCard Grid.Row="0" Title="设备位置监控">
                <controls:PanelCard.HeaderRight>
                    <TextBlock Text="角度 / 位移" Style="{StaticResource T.Aux}" />
                </controls:PanelCard.HeaderRight>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <UniformGrid Rows="2" Columns="2">
                        <Border Style="{StaticResource MiniCard}" Margin="0,0,5,6"
                                ToolTip="一站数据.转盘当前角度 · DB120 偏移 20.0 · REAL">
                            <controls:Metric Label="转盘角度" Value="{Binding AxisTurnText}" Unit="°" ValueSize="21"
                                             ValueBrush="{StaticResource B.Accent}" />
                        </Border>
                        <Border Style="{StaticResource MiniCard}" Margin="5,0,0,6"
                                ToolTip="一站数据.机械手当前位置 · DB120 偏移 24.0 · REAL">
                            <controls:Metric Label="机械手位置" Value="{Binding AxisRobotText}" Unit="mm" ValueSize="21"
                                             ValueBrush="{StaticResource B.Cyan}" />
                        </Border>
                        <Border Style="{StaticResource MiniCard}" Margin="0,0,5,0"
                                ToolTip="三站数据.X轴当前位置 · DB120 偏移 136.0 · REAL">
                            <controls:Metric Label="X 轴位置" Value="{Binding AxisXText}" Unit="mm" ValueSize="21"
                                             ValueBrush="{StaticResource B.Yellow}" />
                        </Border>
                        <Border Style="{StaticResource MiniCard}" Margin="5,0,0,0"
                                ToolTip="三站数据.Y轴当前位置 · DB120 偏移 140.0 · REAL">
                            <controls:Metric Label="Y 轴位置" Value="{Binding AxisYText}" Unit="mm" ValueSize="21"
                                             ValueBrush="{StaticResource B.Red}" />
                        </Border>
                    </UniformGrid>

                    <TextBlock Grid.Row="1" Style="{StaticResource T.Aux}" Foreground="{StaticResource B.Gray}"
                               Margin="0,10,0,0" Text="DB120 无轴速度字段，速度未做推算" />
                </Grid>
            </controls:PanelCard>

            <!-- 订单加工数据分析 -->
            <controls:PanelCard Grid.Row="2" Title="订单加工数据分析">
                <controls:PanelCard.HeaderRight>
                    <TextBlock Text="软件统计" Style="{StaticResource T.Aux}" />
                </controls:PanelCard.HeaderRight>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="3">
                        <controls:Metric Label="当前订单" Value="{Binding CurOrderText}" ValueSize="22" />
                        <controls:Metric Label="正在加工" Value="{Binding BusyCountText}" Unit="站" ValueSize="22"
                                         ValueBrush="{StaticResource B.Accent}" />
                        <controls:Metric Label="已完成订单" Value="{Binding CompletedText}" ValueSize="22"
                                         ValueBrush="{StaticResource B.Green}" />
                    </UniformGrid>

                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,16,0,0">
                        <controls:Metric Label="合格数量" Value="{Binding OkCountText}" ValueSize="22"
                                         ValueBrush="{StaticResource B.Green}" />
                        <controls:Metric Label="不合格数量" Value="{Binding NgCountText}" ValueSize="22"
                                         ValueBrush="{StaticResource B.Red}" />
                        <controls:Metric Label="合格率" Value="{Binding PassRateText}" ValueSize="22" />
                    </UniformGrid>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <ProgressBar Style="{StaticResource Bar.Pass}" Value="{Binding PassPercent, Mode=OneWay}"
                                     Foreground="{StaticResource B.Green}" Maximum="100" />
                    </StackPanel>

                    <TextBlock Grid.Row="3" VerticalAlignment="Bottom" Margin="0,6,0,0"
                               Style="{StaticResource T.Aux}" Foreground="{StaticResource B.Gray}"
                               Text="等待加工数量：DB120 无订单队列字段" />
                </Grid>
            </controls:PanelCard>

            <!-- 智能仓储单元 -->
            <controls:PanelCard Grid.Row="4" Title="智能仓储单元" Cursor="Hand"
                                ToolTip="点击查看本单元全部 DB120 字段">
                <controls:PanelCard.InputBindings>
                    <MouseBinding MouseAction="LeftClick" CommandParameter="2"
                                  Command="{Binding DataContext.OpenUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </controls:PanelCard.InputBindings>
                <controls:PanelCard.HeaderRight>
                    <StackPanel Orientation="Horizontal">
                        <controls:StatusChip Text="{Binding S3ModeText}" Color="{Binding S3ModeBrush}" Margin="0,0,6,0" />
                        <controls:StatusChip Text="{Binding S3BusyText}" Color="{Binding S3BusyBrush}" Margin="0,0,6,0" />
                        <controls:StatusChip Text="{Binding S3FaultText}" Color="{Binding S3FaultBrush}"
                                             Pulse="{Binding S3IsFault}" />
                    </StackPanel>
                </controls:PanelCard.HeaderRight>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="4">
                        <controls:Metric Label="入站扫码" Value="{Binding S3InboundText}" ValueSize="16" />
                        <controls:Metric Label="入库扫码" Value="{Binding S3StorageText}" ValueSize="16" />
                        <controls:Metric Label="称重" Value="{Binding S3WeightText}" Unit="g" ValueSize="16"
                                         ValueBrush="{StaticResource B.Green}" />
                        <controls:Metric Label="合格状态" Value="{Binding S3QualityText}" ValueSize="16"
                                         ValueBrush="{Binding S3QualityBrush}" />
                    </UniformGrid>

                    <Grid Grid.Row="1" Margin="0,14,0,8">
                        <TextBlock Text="成品仓位 A ~ I" Style="{StaticResource T.Label}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="占用" Style="{StaticResource T.Aux}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SlotOccupiedText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource B.Green}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" Rows="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,8" CornerRadius="6" BorderThickness="1"
                                        BorderBrush="{Binding Brush}">
                                    <Border.ToolTip>
                                        <TextBlock>
                                            <Run Text="DB120 三站数据.仓位状态" />
                                            <Run Text="{Binding Address, Mode=OneWay}" />
                                            <Run Text="· BOOL[9]" />
                                        </TextBlock>
                                    </Border.ToolTip>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FF17242E" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Occupied}" Value="True">
                                                    <Setter Property="Background" Value="#FF1B3341" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="12,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:Lamp Color="{Binding Brush}" Diameter="8" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold"
                                                       Foreground="{Binding Brush}" Margin="10,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding StateText}" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{Binding Brush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Row="3" BorderBrush="#FF2A3E4C" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="合格" Style="{StaticResource T.Aux}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding S3OkText}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource B.Green}" Margin="6,0,14,0" VerticalAlignment="Center" />
                                <TextBlock Text="不合格" Style="{StaticResource T.Aux}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding S3NgText}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource B.Red}" Margin="6,0,14,0" VerticalAlignment="Center" />
                                <controls:Lamp Color="{Binding S3DoneBrush}" Diameter="6" VerticalAlignment="Center" />
                                <TextBlock Text="完成" Style="{StaticResource T.Aux}" Margin="5,0,12,0" VerticalAlignment="Center" />
                                <controls:Lamp Color="{Binding S3RecvBrush}" Diameter="6" VerticalAlignment="Center" />
                                <TextBlock Text="已接收" Style="{StaticResource T.Aux}" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="工作时间" Style="{StaticResource T.Aux}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding S3WorkTimeText}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource B.Label}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </controls:PanelCard>
        </Grid>
    </Grid>
</UserControl>
