<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 第二轮：现代工业 SCADA 色板 ============ -->
    <Color x:Key="C.Window">#FF101820</Color>
    <Color x:Key="C.Accent">#FF36A9E1</Color>

    <SolidColorBrush x:Key="B.Window" Color="#FF101820" />
    <SolidColorBrush x:Key="B.WindowDeep" Color="#FF0B1117" />
    <SolidColorBrush x:Key="B.Border" Color="#FF344956" />
    <SolidColorBrush x:Key="B.BorderSoft" Color="#FF2A3E4C" />
    <SolidColorBrush x:Key="B.Accent" Color="#FF36A9E1" />
    <SolidColorBrush x:Key="B.AccentDim" Color="#FF2A7EA8" />
    <SolidColorBrush x:Key="B.Value" Color="#FFE6EDF3" />
    <SolidColorBrush x:Key="B.Label" Color="#FF9BAEBB" />
    <SolidColorBrush x:Key="B.Muted" Color="#FF6B7F8C" />
    <SolidColorBrush x:Key="B.Green" Color="#FF36C98F" />
    <SolidColorBrush x:Key="B.Red" Color="#FFEF6262" />
    <SolidColorBrush x:Key="B.Amber" Color="#FFF2B45B" />
    <SolidColorBrush x:Key="B.Gray" Color="#FF55676F" />
    <SolidColorBrush x:Key="B.Cyan" Color="#FF42C6C5" />
    <SolidColorBrush x:Key="B.Yellow" Color="#FFE3C558" />
    <SolidColorBrush x:Key="B.Purple" Color="#FFA78BFA" />

    <!-- 卡片底：极轻微上下渐变，营造层次但不花 -->
    <LinearGradientBrush x:Key="B.Panel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF1A2A37" Offset="0" />
        <GradientStop Color="#FF16232F" Offset="1" />
    </LinearGradientBrush>

    <!-- 模块内次级卡片 -->
    <SolidColorBrush x:Key="B.Inset" Color="#FF203442" />
    <SolidColorBrush x:Key="B.InsetHover" Color="#FF26404F" />

    <!-- 顶栏 -->
    <SolidColorBrush x:Key="B.TopBar" Color="#FF141F28" />

    <!-- 字体 -->
    <FontFamily x:Key="F.Sans">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Num">Segoe UI, Microsoft YaHei UI</FontFamily>

</ResourceDictionary>
