<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DLDS532.App.Controls">

    <!-- ==================== 文字层级 ==================== -->
    <Style x:Key="T.CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.Value}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="T.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Label}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="T.Aux" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Muted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="T.PanelTitle" TargetType="TextBlock" BasedOn="{StaticResource T.CardTitle}" />

    <!-- 旧页面沿用的辅助文字别名 -->
    <Style x:Key="T.LabelSm" TargetType="TextBlock" BasedOn="{StaticResource T.Aux}" />

    <Style x:Key="T.Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Num}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.Value}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="T.ValueMd" TargetType="TextBlock" BasedOn="{StaticResource T.Value}">
        <Setter Property="FontSize" Value="19" />
    </Style>

    <Style x:Key="T.ValueSm" TargetType="TextBlock" BasedOn="{StaticResource T.Value}">
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="T.Unit" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource B.Muted}" />
        <Setter Property="Margin" Value="4,0,0,3" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style x:Key="T.TableHead" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource B.Muted}" />
    </Style>

    <!-- ==================== 卡片 ==================== -->
    <Style TargetType="{x:Type controls:PanelCard}">
        <Setter Property="Padding" Value="16,14,16,14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PanelCard}">
                    <Border x:Name="Bd" Background="{StaticResource B.Panel}"
                            BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                            CornerRadius="8" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270"
                                              Opacity="0.38" Color="#FF000000" />
                        </Border.Effect>
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{TemplateBinding Title}"
                                           Style="{StaticResource T.CardTitle}" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding HeaderRight}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Border Grid.Row="1" Height="1" Background="#FF22323E" Margin="0,0,0,14" />

                            <ContentPresenter Grid.Row="2" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FF425C6B" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 模块内次级小卡片 -->
    <Style x:Key="MiniCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Inset}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8,12,8" />
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>

    <!-- ==================== 指标 ==================== -->
    <Style TargetType="{x:Type controls:Metric}">
        <Setter Property="Foreground" Value="{StaticResource B.Value}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Metric}">
                    <StackPanel>
                        <TextBlock Text="{TemplateBinding Label}" Style="{StaticResource T.Label}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock x:Name="ValueText" Text="{TemplateBinding Value}"
                                       FontFamily="{StaticResource F.Num}"
                                       FontSize="{TemplateBinding ValueSize}"
                                       FontWeight="Normal"
                                       Foreground="{TemplateBinding ValueBrush}"
                                       TextOptions.TextFormattingMode="Display" />
                            <TextBlock Text="{TemplateBinding Unit}" Style="{StaticResource T.Unit}" />
                        </StackPanel>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Emphasis" Value="True">
                            <Setter TargetName="ValueText" Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="ValueText" Property="FontSize" Value="26" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 状态标签 ==================== -->
    <Style TargetType="{x:Type controls:StatusChip}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:StatusChip}">
                    <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                            CornerRadius="11" Padding="9,3">
                        <StackPanel Orientation="Horizontal">
                            <controls:Lamp Color="{TemplateBinding Color}" Diameter="7" VerticalAlignment="Center"
                                           Pulse="{TemplateBinding Pulse}" />
                            <TextBlock Text="{TemplateBinding Text}" Margin="6,0,0,0" FontSize="11.5"
                                       FontFamily="{StaticResource F.Sans}"
                                       Foreground="{TemplateBinding Color}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 表格状态标签（无圆点） -->
    <Style x:Key="Tag.Text" TargetType="Border">
        <Setter Property="Background" Value="#16FFFFFF" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ==================== 按钮 ==================== -->
    <Style x:Key="Btn.Chip" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource B.Label}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="#12FFFFFF" BorderBrush="{StaticResource B.Border}"
                            BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FF4A6675" />
                            <Setter Property="Foreground" Value="{StaticResource B.Value}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.ChipPrimary" TargetType="Button">
        <Setter Property="Foreground" Value="#FF0B1117" />
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource B.Accent}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF54BFEE" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 趋势图例 / 时间窗开关 -->
    <Style x:Key="Btn.SeriesChip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource B.Label}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="#0CFFFFFF" BorderBrush="Transparent"
                            BorderThickness="1" CornerRadius="4" Padding="9,4">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1F36A9E1" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#6636A9E1" />
                            <Setter Property="Foreground" Value="{StaticResource B.Value}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#16FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 左侧导航 -->
    <Style x:Key="Btn.Nav" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource B.Label}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Height="62" Margin="8,2">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent" />
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#12FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource B.Value}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1F36A9E1" />
                            <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.32" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 输入 ==================== -->
    <Style x:Key="Input.Dark" TargetType="TextBox">
        <Setter Property="Background" Value="#FF14212B" />
        <Setter Property="Foreground" Value="{StaticResource B.Value}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontFamily" Value="{StaticResource F.Num}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CaretBrush" Value="{StaticResource B.Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource B.AccentDim}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Check.Dark" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource B.Label}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                                Background="#FF14212B" VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="M2,7 L6,11 L12,3" Stroke="#FF0B1117" StrokeThickness="1.8"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 合格率进度条 -->
    <Style x:Key="Bar.Pass" TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="#FF203442" CornerRadius="4">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="4" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 细滚动条 -->
    <Style x:Key="Scroll.Dark" TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#26FFFFFF" CornerRadius="3" Margin="1,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource Scroll.Dark}" />

</ResourceDictionary>
